{
  "name": "pi-workmap",
  "version": "0.1.0",
  "description": "A live, agent-maintained workmap for human-agent alignment in Pi sessions.",
  "license": "Apache-2.0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent",
    "alignment",
    "tui"
  ],
  "type": "module",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2",
    "@earendil-works/pi-tui": ">=0.84.2"
  },
  "dependencies": {
    "typebox": "^1.3.22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^25.0.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "build": "tsc",
    "docs:screenshot": "tsx test/visual/capture.ts",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "prompts": [
      "./prompts/workmap-tidy.md"
    ]
  }
}
